      "subject": "关于丰台区西四环外侧区域增加充电桩的建议",
      "nickName": "用户20****4",
      "typeId": 5,
      "domainId": 7,
      "typeName": "建言",
      "domainName": "城建",
      "stateInfo": "已办理",
      "createDateline": 1762506981,
